# Copy to .env.local and fill in. Never commit real values.
# Only the four NEXT_PUBLIC_ variables reach the browser, and each is fixed into the build. Everything else is server-only.

NEXT_PUBLIC_SITE_URL=https://[DOMAIN]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM="[BRAND] <hello@[DOMAIN]>"
EMAIL_REPLY_TO=
FOUNDER_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32+ random bytes, e.g. `openssl rand -hex 32`
UNSUBSCRIBE_SECRET=
# 32+ random bytes, e.g. `openssl rand -hex 32`
IP_HASH_SALT=
# Optional: analytics do nothing and Sentry is skipped when these are empty.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=[DOMAIN]
SENTRY_DSN=
# Same DSN again, for errors in the browser (a DSN is meant to be public).
NEXT_PUBLIC_SENTRY_DSN=

# CI and tests only: skip start-up env validation. Never set this in production.
# SKIP_ENV_VALIDATION=1
